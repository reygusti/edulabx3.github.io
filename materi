    <!-- Script Interaktif -->
    <script>
        // FUNGSI 1: MEMBUKA AKORDEON (PREVIEW)
        function toggleMateri(element) {
            const isActive = element.classList.contains('active');
            
            // Tutup semua dropdown terlebih dahulu
            document.querySelectorAll('.list-item').forEach(item => {
                item.classList.remove('active');
            });

            // Jika yang diklik belum terbuka, maka buka (expand)
            if (!isActive) {
                element.classList.add('active');
                
                // Scroll agar materi terlihat dengan jelas di layar
                setTimeout(() => {
                    element.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 200);
            }
        }

        // FUNGSI 2: MEMBUKA HALAMAN LAYAR PENUH (SPA) Tanpa berpindah file HTML
        function openDetail(event, judulPelajaran) {
            // Mencegah klik menyebar ke fungsi toggleMateri
            event.stopPropagation();
            
            // Mengambil elemen "materi-teks" dari list yang diklik
            const listItem = event.target.closest('.list-item');
            const contentHtml = listItem.querySelector('.materi-teks').innerHTML;
            
            // Menyalin konten html
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = contentHtml;
            
            // Hapus tombol "Buka Mode Layar Penuh" di versi layar penuh
            const btn = tempDiv.querySelector('.btn-baca-penuh');
            if(btn) btn.remove();

            // Pasang teks dan judul ke Halaman Layar Penuh (View Detail)
            document.getElementById('detail-title').innerText = judulPelajaran;
            document.getElementById('detail-content').innerHTML = tempDiv.innerHTML;

            // Sembunyikan daftar, tampilkan layar penuh
            document.getElementById('view-list').classList.remove('active');
            document.getElementById('view-detail').classList.add('active');
            
            // Pindahkan posisi layar kembali ke atas
            document.querySelector('.app-container').scrollTo({ top: 0, behavior: 'auto' });
            
            // Tambahkan histori browser (agar tombol 'Back' bawaan hp berfungsi)
            history.pushState({ view: 'detail' }, '', '#baca-materi');
        }

        // FUNGSI 3: MENUTUP HALAMAN LAYAR PENUH
        function closeDetail() {
            document.getElementById('view-detail').classList.remove('active');
            document.getElementById('view-list').classList.add('active');
            
            // Pindahkan posisi layar kembali ke atas
            document.querySelector('.app-container').scrollTo({ top: 0, behavior: 'auto' });
        }

        // FUNGSI 4: MENCEGAH KELUAR APLIKASI KETIKA MENEKAN TOMBOL BACK DI HP
        window.addEventListener('popstate', function(event) {
            // Jika sedang berada di mode layar penuh (view-detail aktif), tutup halamannya
            const viewDetail = document.getElementById('view-detail');
            if(viewDetail.classList.contains('active')) {
                viewDetail.classList.remove('active');
                document.getElementById('view-list').classList.add('active');
            }
        });
    </script>
</body>
</html>
