        <!-- ========================================== -->
        <!-- VIEW 2: HALAMAN BACA MATERI LAYAR PENUH    -->
        <!-- ========================================== -->
        <div id="view-detail" class="view">
            <!-- Header Mode Baca -->
            <div class="top-bar" style="background: var(--primary); color: white; border-bottom: none;">
                <!-- Tombol kembali ke View List -->
