<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Materi Pelajaran - MAN6 EDU Lab</title>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --accent: #6366f1;
            --accent-soft: rgba(99, 102, 241, 0.1);
            --bg-body: #e2e8f0;
            --bg-app: #f8fafc;
            --surface: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --text-light: #94a3b8;
            --danger: #ef4444;
            --success: #10b981;
            --warning: #f59e0b;
            --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
            --glass-bg: rgba(255, 255, 255, 0.85);
            --radius-lg: 24px;
            --radius-md: 16px;
            --radius-sm: 12px;
            --safe-bottom: env(safe-area-inset-bottom, 20px);
        }

        * { 
            margin: 0; padding: 0; box-sizing: border-box; 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            -webkit-tap-highlight-color: transparent; 
        }

        /* Hide Scrollbar */
        ::-webkit-scrollbar { display: none; }
        * { scrollbar-width: none; }

        body { 
            background-color: var(--bg-body); 
            display: flex; justify-content: center; 
            min-height: 100vh; color: var(--text-main); 
        }

        /* App Container */
        .app-container {
            width: 100%; max-width: 440px; 
            background-color: var(--bg-app);
            min-height: 100vh; position: relative; 
            overflow-x: hidden; overflow-y: auto;
            box-shadow: 0 0 40px rgba(0,0,0,0.1);
            padding-bottom: calc(40px + var(--safe-bottom));
        }

        /* --- SPA VIEW SYSTEM --- */
        .view { display: none; }
        .view.active { display: block; animation: slideIn 0.3s ease-out; }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* --- COMPONENTS --- */
        .top-bar {
            padding: 2rem 1.5rem 1rem;
            display: flex; align-items: center; gap: 15px;
            background: var(--glass-bg); backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            position: sticky; top: 0; z-index: 100;
            border-bottom: 1px solid rgba(0,0,0,0.02);
        }

        .back-btn {
            width: 40px; height: 40px; border-radius: var(--radius-sm);
            background: var(--surface); display: flex; align-items: center; justify-content: center;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); cursor: pointer;
            border: 1px solid rgba(0,0,0,0.02); transition: 0.2s;
            color: var(--text-main); text-decoration: none;
        }
        .back-btn:active { transform: scale(0.9); }

        /* Theme Colors for Icons */
        .c-indigo { background: #eef2ff; color: #4f46e5; }
        .c-rose { background: #fff1f2; color: #e11d48; }
        .c-emerald { background: #ecfdf5; color: #059669; }
        .c-sky { background: #f0f9ff; color: #0284c7; }
        .c-amber { background: #fffbeb; color: #d97706; }

        /* Search Box */
        .search-container { padding: 0 1.5rem 1rem; }
        .search-box {
            background: white; display: flex; align-items: center; 
            padding: 12px 15px; border-radius: var(--radius-md); 
            box-shadow: 0 4px 10px rgba(0,0,0,0.03); border: 1px solid rgba(0,0,0,0.02);
        }
        .search-box input {
            border: none; outline: none; width: 100%; font-size: 0.9rem; 
            background: transparent; font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Category Pills */
        .category-pills {
            display: flex; gap: 10px; overflow-x: auto; 
            padding: 0 1.5rem 1.5rem; scroll-snap-type: x mandatory;
        }
        .pill {
            padding: 8px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; 
            white-space: nowrap; cursor: pointer; text-decoration: none;
            transition: 0.2s; border: 1px solid #e2e8f0; background: white; color: var(--text-muted);
        }
        .pill.active {
            background: var(--primary); color: white; border-color: var(--primary);
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.3);
        }

        /* List Items & Accordion */
        .list-container { padding: 0 1.5rem 1rem; display: flex; flex-direction: column; gap: 1rem; }
        .list-item {
            background: var(--surface); padding: 1.2rem; border-radius: var(--radius-md);
            box-shadow: var(--card-shadow); display: flex; flex-direction: column; 
            border: 1px solid rgba(0,0,0,0.02); cursor: pointer; transition: 0.2s; 
            color: inherit;
        }
        .item-main { display: flex; align-items: flex-start; gap: 15px; width: 100%; }
        
        .list-icon { 
            width: 48px; height: 48px; border-radius: 14px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 1.2rem; 
        }
        .list-content { flex: 1; width: 100%; }
        .list-content h4 { font-size: 1rem; margin-bottom: 4px; color: var(--text-main); }
        .list-content p { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 2px; line-height: 1.4; }
        
        .item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px; }
        .badge { font-size: 0.65rem; padding: 4px 8px; border-radius: 8px; font-weight: 700; text-transform: uppercase; }
        .badge-wajib { background: #f1f5f9; color: #64748b; }
        .badge-mipa { background: #eef2ff; color: #4f46e5; }
        .badge-ips { background: #fffbeb; color: #d97706; }

        .chevron { transition: transform 0.3s; color: var(--text-light); display: flex; align-items: center; height: 100%; }
        .list-item.active .chevron { transform: rotate(180deg); color: var(--primary); }

        /* TAMPILAN MATERI (ISI BACAAN) */
        .materi-detail { 
            display: none; width: 100%; padding-top: 15px; margin-top: 15px; 
            border-top: 1px dashed #e2e8f0; animation: fadeIn 0.3s;
        }
        .list-item.active .materi-detail { display: block; }
        
        .materi-teks {
            background: #f8fafc; padding: 15px; border-radius: 12px;
            font-size: 0.85rem; line-height: 1.6; color: #334155;
            border: 1px solid #e2e8f0;
        }
        .materi-teks h5 { 
            color: var(--primary); font-size: 1.05rem; margin-bottom: 10px; 
            border-bottom: 2px solid var(--accent-soft); padding-bottom: 5px; 
        }
        .materi-teks h6 { font-size: 0.9rem; color: var(--text-main); margin-top: 15px; margin-bottom: 5px; font-weight: 700; }
        .materi-teks p { margin-bottom: 8px; text-align: justify; }
        .materi-teks ul, .materi-teks ol { padding-left: 20px; margin-bottom: 8px; }
        .materi-teks li { margin-bottom: 6px; }
        
        .btn-baca-penuh {
            display: block; text-align: center; width: 100%; padding: 12px;
            background: var(--primary); color: white; border: none; border-radius: 8px;
            margin-top: 15px; font-weight: 700; font-size: 0.85rem; cursor: pointer;
            transition: 0.2s; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);
        }
        .btn-baca-penuh:active { transform: scale(0.98); }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="app-container">
        
        <!-- ========================================== -->
        <!-- VIEW 1: DAFTAR MATERI PELAJARAN            -->
        <!-- ========================================== -->
        <div id="view-list" class="view active">
            <!-- Header -->
            <div class="top-bar">
                <!-- Tombol back mengarah kembali ke index.html -->
                <a href="index.html" class="back-btn"><i class="fa-solid fa-arrow-left"></i></a>
                <h2 style="font-size: 1.2rem; font-weight: 800;">Materi Kelas 10</h2>
            </div>

            <!-- Search Input -->
            <div class="search-container">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass" style="color: #94a3b8; margin-right: 10px;"></i>
